{
  "name": "useful-pedagogue-backend",
  "version": "1.0.0",
  "description": "Backend API for Useful Pedagogue",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "clear:courses": "node src/scripts/clear-courses-and-lessons.js",
    "clear:courses:dry": "node src/scripts/clear-courses-and-lessons.js --dry-run",
    "clear:courses:keep-groups": "node src/scripts/clear-courses-and-lessons.js --keep-groups",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.12.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.5",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.6",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/helmet": "^0.0.48",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "proxy-addr": "2.0.8",
    "engine.io": "6.6.10",
    "socket.io-parser": "4.2.7"
  }
}