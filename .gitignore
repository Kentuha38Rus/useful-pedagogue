# ============================================================
#  .gitignore — защита репозитория
#  НЕ добавлять BOM, сохранять в UTF-8 без BOM.
# ============================================================

# ---- Зависимости ----
node_modules/
*/node_modules/

# ---- Переменные окружения ----
.env
.env.*
!.env.example
*.env
.env.local
.env.*.local
.env.production

# ---- Логи ----
*.log
*.log.*
logs/
combined.log
error.log

# ---- Сборки ----
dist/
build/
.cache/
*/dist/
*/build/
dev-dist/
*/dev-dist/

# ---- Артефакты сканеров ----
audit.json
*/audit.json
npm-audit.json
trivy-*.json
trivy-*.txt

# ---- Дампы БД ----
*.dump
*.sql.gz
backup*.sql
backups/

# ---- Docker ----
docker-compose.override.yml

# ---- Let's Encrypt (критично: не коммитим приватные ключи) ----
nginx/certs/*
!nginx/certs/.gitkeep
!nginx/certs/renewal-hooks/
nginx/certs/renewal-hooks/**/*
!nginx/certs/renewal-hooks/deploy/
!nginx/certs/renewal-hooks/deploy/*.sh

# ---- Certbot webroot (временные challenge-файлы) ----
nginx/certbot/*
!nginx/certbot/.gitkeep

# ---- Certbot logs ----
nginx/certbot-logs/

# ---- Системные файлы ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Файлы редакторов ----
.vscode/
.idea/
*.swp
*.swo

# ---- Временные / личные файлы ----
register.json
Подсказка/
structure.txt
Structure.txt