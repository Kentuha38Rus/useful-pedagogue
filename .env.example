# ============================================================
#  .env.example — шаблон для корневого .env
#  Скопируйте в .env и заполните реальными значениями.
#  Реальный .env НЕ коммитится в git (см. .gitignore).
# ============================================================

NODE_ENV=production

# ---------- Postgres ----------
DB_USER=pedagogue
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=useful_pedagogue
DB_HOST=postgres
DB_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- JWT ----------
# openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- VAPID (Web Push) ----------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE
VAPID_EMAIL=mailto:ssl@juurnal.ru

# ---------- CORS ----------
# Через запятую, БЕЗ пробелов.
# ВАЖНО: /api и /socket.io проксируются через nginx каждого домена —
# для браузера это same-origin, CORS не срабатывает.
# Список ниже — «страховка» для будущих внешних клиентов.
CORS_ORIGINS=https://juurnal.ru,https://www.juurnal.ru,https://admin.juurnal.ru,https://app.juurnal.ru

# ---------- Frontend ----------
# В проде — относительный путь, чтобы ходить через nginx (same-origin)
VITE_API_URL=/api
VITE_BASE_PATH=/

# ---------- Let's Encrypt ----------
# Email для регистрации аккаунта Certbot (уведомления об истечении сертификатов)
CERTBOT_EMAIL=ssl@juurnal.ru