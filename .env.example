# ============================================================
#  .env.example — шаблон для корневого .env
#  Скопируйте в .env и заполните реальными значениями.
#  Реальный .env НЕ коммитится в git.
# ============================================================

NODE_ENV=production

# ---------- Postgres ----------
DB_USER=pedagogue
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=useful_pedagogue
DB_HOST=postgres
DB_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
# openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- VAPID (push) ----------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE
VAPID_EMAIL=mailto:admin@example.com

# ---------- CORS ----------
# Через запятую, БЕЗ пробелов
CORS_ORIGINS=https://useful-pedagogue.ru,https://admin.useful-pedagogue.ru

# ---------- Frontend ----------
# В проде — относительный путь, чтобы ходить через nginx
VITE_API_URL=/api
VITE_BASE_PATH=/